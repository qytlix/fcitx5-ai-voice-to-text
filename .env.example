# Server
APP_ENV=development
HOST=0.0.0.0
PORT=8080

# External provider keys. Keep real values in .env, never commit them.
ASR_PROVIDER=mock
LLM_PROVIDER=mock
ASR_API_KEY=
LLM_API_KEY=

# 接口鉴权：留空 = 不鉴权（原型默认）；填一个随机串即可要求客户端带 X-API-Token 头。
API_TOKEN=

# Request limits
MAX_AUDIO_MB=10
REQUEST_TIMEOUT_SECONDS=30

# CORS：逗号分隔的来源列表，或 "*" 表示允许所有。生产环境务必收紧为具体域名。
CORS_ALLOW_ORIGINS=*
