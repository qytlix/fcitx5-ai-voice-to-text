# ========== 服务基础 ==========
APP_ENV=development                 # development | production
HOST=0.0.0.0
PORT=8080

# ========== ASR（语音识别）==========
# Provider: mock | xunfei | whisper | ...
ASR_PROVIDER=xunfei

# 讯飞 IAT API 认证信息（获取地址：https://console.xfyun.cn/）
# 文档：https://www.xfyun.cn/doc/spark/spark_zh_iat.html
ASR_API_KEY=                     # 讯飞应用 ID (app_id)
ASR_API_SECRET=                  # 讯飞 API Key (api_key)
ASR_API_PASSWORD=                # 讯飞 API Secret (api_secret)

# ========== LLM（风格化）==========
# Provider: mock | deepseek | qwen | claude | ...
LLM_PROVIDER=mock
LLM_API_KEY=                     # 对应 LLM 的 API Key

# ========== 接口鉴权 ==========
# 客户端需在请求头带 X-API-Token 才能调用 /v1/transcribe
# 留空 = 不鉴权（原型默认）；生产环境填一个随机串即可开启
API_TOKEN=

# ========== 请求限制 ==========
MAX_AUDIO_MB=10                  # 单次请求音频大小上限（MB）
REQUEST_TIMEOUT_SECONDS=30       # 调用外部 API 的超时时间（秒）

# ========== CORS ==========
# "*" 允许所有来源；生产环境改为具体域名如 "https://app.example.com"
CORS_ALLOW_ORIGINS=*
